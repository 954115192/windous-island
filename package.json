{
  "name": "dynamic-island-host",
  "version": "0.2.0",
  "private": true,
  "description": "独立 Web 插件驱动的 Windows Electron 灵动岛 Host",
  "author": "Activity Island",
  "license": "CC-BY-NC-4.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "new-plugin": "node scripts/new-plugin.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "test:contract": "node scripts/tests/contract-unit.cjs && node scripts/tests/phase-c-authoring.cjs",
    "test:ui": "electron scripts/tests/settings-ui.cjs",
    "test:bg": "electron scripts/tests/background-e2e.cjs",
    "test:click": "electron scripts/tests/click-expand-e2e.cjs",
    "test:presence": "electron scripts/tests/presence-e2e.cjs",
    "test:alert": "electron scripts/tests/alert-visual-e2e.cjs",
    "test:anim": "electron scripts/tests/animation-e2e.cjs",
    "test:geo": "electron scripts/tests/geometry-e2e.cjs",
    "test:wheel": "electron scripts/tests/wheel-picker-e2e.cjs",
    "test:pack": "node scripts/tests/zip-unit.cjs && electron scripts/tests/package-roundtrip-e2e.cjs",
    "test:dist": "electron scripts/tests/packaged-asar-e2e.cjs",
    "test:workbench": "electron scripts/tests/workbench-api-e2e.cjs && electron scripts/tests/workbench-registry-e2e.cjs && electron scripts/tests/workbench-open-e2e.cjs && electron scripts/tests/workbench-page-e2e.cjs && electron scripts/tests/workbench-ui.cjs",
    "test:icons": "electron scripts/tests/icon-e2e.cjs",
    "test:settings": "electron scripts/tests/settings-ui.cjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.1"
  }
}
